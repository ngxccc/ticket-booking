{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "src/generated/**",
    "test/generated/**",
    ".*/**"
  ],
  "plugins": ["typescript", "import", "unicorn"],
  "env": {
    "node": true,
    "builtin": true
  },
  "options": {
    "typeAware": true
  },
  "extends": [
    "./node_modules/oxlint-config-presets/@typescript-eslint/recommended-type-checked.json",
    "./node_modules/oxlint-config-presets/@typescript-eslint/stylistic-type-checked.json"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "typescript/consistent-type-imports": "off",
    "typescript/no-misused-promises": [
      "error",
      { "checksVoidReturn": { "attributes": false } }
    ],
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }],
    "typescript/no-empty-object-type": "error",
    "typescript/consistent-return": "off",
    "typescript/unbound-method": "off",
    "typescript/no-unsafe-assignment": "off",
    "typescript/no-unsafe-member-access": "off",
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-argument": "off",
    "typescript/no-unsafe-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "import/no-cycle": ["error", { "maxDepth": 10, "ignoreTypes": true }],
    "import/no-unassigned-import": "off",
    "unicorn/no-thenable": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "error",
    "eslint/no-underscore-dangle": "off"
  },
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.test.ts", "test/**"],
      "rules": {
        "typescript/unbound-method": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "eslint/no-unsafe-optional-chaining": "off"
      }
    }
  ]
}
