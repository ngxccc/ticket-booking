{
  "name": "ticket-booking",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "check": "bun run check-types && bun run format && bun run lint",
    "dev": "doppler run -- nest start --watch --exec bun",
    "dev:test": "doppler run -c test -- nest start --watch --exec bun",
    "docker:build": "docker build -f docker/Dockerfile -t ghcr.io/ngxccc/ticket-booking:latest .",
    "docker:push": "docker push ghcr.io/ngxccc/ticket-booking:latest",
    "format": "oxfmt --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"eslint.config.ts\" \"drizzle.config.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"eslint.config.ts\" \"drizzle.config.ts\"",
    "lint": "oxlint --type-aware --deny-warnings && eslint . --fix --cache --cache-location .eslintcache",
    "lint:ci": "oxlint --type-aware --deny-warnings -f github && eslint . --cache --cache-location .eslintcache",
    "lint:fast": "oxlint --type-aware --fix",
    "lint:eslint": "eslint . --fix --cache --cache-location .eslintcache",
    "start": "doppler run -- bun dist/main.js",
    "start:test": "doppler run -c test -- bun dist/main.js",
    "start:debug": "doppler run -- nest start --debug --watch --exec bun",
    "test": "bun test src/ --bail",
    "test:cov": "bun test src/ --coverage",
    "test:ci": "mkdir -p coverage && bun test src/ --coverage --reporter=junit --reporter-outfile=coverage/junit.xml",
    "test:e2e": "doppler run --preserve-env=\"true\" -c test -- bun test test/",
    "test:bench": "doppler run --preserve-env=\"true\" -c test -- bun test/benchmarks/runner.ts",
    "test:watch": "bun test src/ --watch",
    "test:load": "doppler run --preserve-env=\"true\" -c test -- bun test/load/runner.ts",
    "db:baseline": "doppler run -c dev -- bun scripts/baseline.ts && doppler run -c prd -- bun scripts/baseline.ts --inject-only && doppler run -c test -- bun scripts/baseline.ts --inject-only",
    "db:generate": "doppler run -- drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "sh -c 'if [ $# -eq 0 ]; then doppler run --preserve-env=\"true\" -- drizzle-kit migrate --config drizzle.config.ts; echo \"\"; else for e in \"$@\"; do echo \"\"; echo \"[DB Migrate] Running for config: $e\"; doppler run --preserve-env=\"true\" -c \"$e\" -- drizzle-kit migrate --config drizzle.config.ts || exit 1; echo \"\"; done; fi' _",
    "db:push": "sh -c 'if [ $# -eq 0 ]; then doppler run -- drizzle-kit push --config drizzle.config.ts; echo \"\"; else for e in \"$@\"; do echo \"\"; echo \"[DB Push] Running for config: $e\"; doppler run --preserve-env=\"true\" -c \"$e\" -- drizzle-kit push --config drizzle.config.ts || exit 1; echo \"\"; done; fi' _",
    "db:seed": "doppler run --preserve-env=\"true\" -- bun src/database/seeds/index.ts",
    "db:seed:reset": "doppler run --preserve-env=\"true\" -- bun src/database/seeds/index.ts --reset",
    "db:seed:clean": "doppler run --preserve-env=\"true\" -- bun src/database/seeds/index.ts --clean",
    "db:studio": "doppler run -- drizzle-kit studio --config drizzle.config.ts",
    "i18n:generate": "bun scripts/generate-i18n-types.ts",
    "openapi:generate": "doppler run -c test -- bun scripts/generate-openapi-types.ts",
    "check-types": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@payos/node": "^2.0.5",
    "@scalar/nestjs-api-reference": "^1.2.26",
    "@sentry/nestjs": "^11.4.0",
    "@t3-oss/env-core": "^0.13.11",
    "bullmq": "^6.3.11",
    "compression": "^1.8.2",
    "drizzle-orm": "^1.0.0-rc.5-5935859",
    "fast-deep-equal": "^3.1.3",
    "ioredis": "^6.0.0",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.32.0",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/bun": "^1.4.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/k6": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^1.0.0-rc.5-5935859",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-oxlint": "^1.86.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-config-presets": "^0.1.20",
    "oxlint-tsgolint": "^7.0.2003",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "^6",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "multer": "^2.3.0",
    "lodash": "^4.18.1",
    "qs": "^6.16.0",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.26",
    "nanoid": "^3.3.18",
    "brace-expansion": "5.0.12"
  }
}
